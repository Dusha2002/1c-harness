# LLM selection
LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-3-Ultra
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
# Optional path to the Russian trusted root CA bundle:
GIGACHAT_CA_BUNDLE=

# OpenAI / DeepSeek / any OpenAI-compatible endpoint
LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# 1C:Enterprise
ONEC_EXE=C:\Program Files\1cv8\8.3.xx.xxxx\bin\1cv8.exe
# Example: /F "C:\1c\demo"
# Example server connection: /S "server\infobase"
ONEC_IB_CONNECTION=
ONEC_USER=
ONEC_PASSWORD=
ONEC_WORKSPACE=./workspace
ONEC_COMMAND_TIMEOUT_SECONDS=600
