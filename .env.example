# LLM selection
LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-3-Ultra
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=

# OpenAI / DeepSeek / any OpenAI-compatible endpoint
LLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# 1C:Enterprise
ONEC_EXE=C:\Program Files\1cv8\8.3.xx.xxxx\bin\1cv8.exe
# Primary development infobase. Example: /F "C:\1c\dev"
ONEC_IB_CONNECTION=
# Disposable copy used by the autonomous stage -> check loop. Required for agent --check.
# Example: /F "C:\1c\harness-staging"
ONEC_STAGING_IB_CONNECTION=
ONEC_USER=
ONEC_PASSWORD=
ONEC_WORKSPACE=./workspace
ONEC_COMMAND_TIMEOUT_SECONDS=600

# V83.COMConnector. Leave empty to derive File/Srvr/Ref from ONEC_IB_CONNECTION.
ONEC_COM_CONNECTION=
ONEC_COM_PROGID=V83.COMConnector
# Second opt-in for any COM mutation. Keep false for normal use.
ONEC_RUNTIME_ALLOW_WRITES=false

# 1C automated testing. Test Client falls back to staging when this is empty.
ONEC_TEST_CLIENT_CONNECTION=
# Separate infobase used to run generated Test Manager runner EPFs.
ONEC_TEST_MANAGER_CONNECTION=
ONEC_TEST_MANAGER_USER=
ONEC_TEST_MANAGER_PASSWORD=
ONEC_TEST_HOST=localhost
ONEC_TEST_PORT=1538
ONEC_TEST_CLIENT_ID=
ONEC_TEST_STARTUP_TIMEOUT_SECONDS=30
ONEC_TEST_TIMEOUT_SECONDS=120
